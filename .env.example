# ANTARA — Environment Configuration Example
# Copy this file to .env.local and fill in your values.
# This file IS committed to Git (it contains only safe placeholder values).

# =============================================================
# Operating Mode (Required)
# =============================================================
DEMO_MODE=true
AI_MODE=demo

# =============================================================
# AI Provider (Optional — enables live LLM responses)
# =============================================================
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================
# Razorpay Integration (Optional — use test keys)
# =============================================================
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# IMPORTANT: Must match RAZORPAY_KEY_ID (used by client-side Razorpay checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# =============================================================
# Supabase Database (Optional — for persistent storage)
# =============================================================
# Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================
# Application Settings (Required)
# =============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
